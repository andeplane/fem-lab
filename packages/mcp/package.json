{
  "name": "femlab-mcp",
  "version": "0.1.0",
  "description": "FEM Lab as an MCP server: every engine Command and Query as a tool, over stdio.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "femlab-mcp": "dist/femlab-mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/femlab-mcp.ts src/script-worker.ts src/script-validation-worker.ts --bundle --platform=node --format=esm --target=node22 --external:quickjs-emscripten --external:typescript --outdir=dist --banner:js=\"#!/usr/bin/env node\"",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p . --noEmit",
    "pretest": "node ../../tools/build-script-declarations.mjs && npm run build",
    "prebuild": "node ../../tools/build-script-declarations.mjs",
    "pretypecheck": "node ../../tools/build-script-declarations.mjs"
  },
  "dependencies": {
    "@femlab/registry": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "quickjs-emscripten": "^0.32.0",
    "sucrase": "^3.35.0",
    "zod": "^4.5.4",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.25.12",
    "vitest": "^5.0.0"
  }
}
