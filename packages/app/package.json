{
  "name": "@femlab/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../tools/build-script-declarations.mjs && node ../../tools/copy-examples.mjs",
    "dev": "vite",
    "prebuild": "node ../../tools/build-script-declarations.mjs && node ../../tools/copy-examples.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "posttest": "node scripts/check-coverage.mjs",
    "typecheck": "tsc -p . --noEmit",
    "e2e": "playwright test",
    "thumbnails": "playwright test --project=thumbnails",
    "postbuild": "node scripts/check-no-secrets.mjs",
    "size": "node ../../tools/size-check.mjs",
    "pretypecheck": "node ../../tools/build-script-declarations.mjs",
    "pretest": "node ../../tools/build-script-declarations.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@femlab/registry": "*",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "openai": "^7.10.0",
    "preact": "^10.29.8",
    "sucrase": "^3.35.1",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.0",
    "@vitest/coverage-v8": "^5.0.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.14.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
