#150=EDGE_CURVE('CG',#112,#116,#130,.T.);
#151=EDGE_CURVE('DH',#113,#117,#131,.T.);

/* Outward boundary orders: ADCB, EFGH, ABFE, BCGF, CDHG, DAEH. */
#170=ORIENTED_EDGE('',*,*,#143,.F.);
#171=ORIENTED_EDGE('',*,*,#142,.F.);
#172=ORIENTED_EDGE('',*,*,#141,.F.);
#173=ORIENTED_EDGE('',*,*,#140,.F.);
#174=ORIENTED_EDGE('',*,*,#144,.T.);
