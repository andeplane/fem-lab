#191=ORIENTED_EDGE('',*,*,#148,.T.);
#192=ORIENTED_EDGE('',*,*,#147,.F.);
#193=ORIENTED_EDGE('',*,*,#151,.F.);
#160=EDGE_LOOP('bottom',(#170,#171,#172,#173));
#161=EDGE_LOOP('top',(#174,#175,#176,#177));
#162=EDGE_LOOP('front',(#178,#179,#180,#181));
#163=EDGE_LOOP('right',(#182,#183,#184,#185));
