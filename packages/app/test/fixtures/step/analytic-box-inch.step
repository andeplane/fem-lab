#127=LINE('HE',#107,#216);
#128=LINE('AE',#100,#208);
#129=LINE('BF',#101,#208);
#130=LINE('CG',#102,#208);
#131=LINE('DH',#103,#208);
#140=EDGE_CURVE('AB',#110,#111,#120,.T.);
#141=EDGE_CURVE('BC',#111,#112,#121,.T.);
#142=EDGE_CURVE('CD',#112,#113,#122,.T.);
#143=EDGE_CURVE('DA',#113,#110,#123,.T.);
#144=EDGE_CURVE('EF',#114,#115,#124,.T.);
#145=EDGE_CURVE('FG',#115,#116,#125,.T.);
#146=EDGE_CURVE('GH',#116,#117,#126,.T.);
