#900=(CONVERSION_BASED_UNIT('INCH',#906) LENGTH_UNIT() NAMED_UNIT(#905));
#905=DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
#906=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0254),#907);
#907=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#901=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#902=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#903=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-9),#900,'distance_accuracy_value','');
#904=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#903)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#900,#901,#902)) REPRESENTATION_CONTEXT('','3D'));
ENDSEC;
