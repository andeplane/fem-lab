ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Self-authored analytic rectangular box: 1 inch x 2 inch x 3 inch'),'2;1');
FILE_NAME('analytic-box-inch.step','2026-10-15T00:00:00',('FEM Lab'),('FEM Lab'),'Hand-authored STEP fixture','Independent analytic geometry','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
/* Independent dimensions: x=[0,1], y=[0,2], z=[0,3], in inches, exactly 0.0254 metres per inch. */
#1=APPLICATION_CONTEXT('configuration controlled 3d designs of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','config_control_design',1994,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('analytic-box','analytic-box','1 inch x 2 inch x 3 inch',(#3));
#5=PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('1','',#4,.NOT_KNOWN.);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#10);
#10=ADVANCED_BREP_SHAPE_REPRESENTATION('analytic-box',(#11,#226),#904);
#11=MANIFOLD_SOLID_BREP('analytic-box',#12);
#12=CLOSED_SHELL('',(#240,#241,#242,#243,#244,#245));

/* A B C D are the lower rectangle; E F G H are directly above them. */
#100=CARTESIAN_POINT('A',(0.,0.,0.));
#101=CARTESIAN_POINT('B',(1.,0.,0.));
#102=CARTESIAN_POINT('C',(1.,2.,0.));
#103=CARTESIAN_POINT('D',(0.,2.,0.));
#104=CARTESIAN_POINT('E',(0.,0.,3.));
#105=CARTESIAN_POINT('F',(1.,0.,3.));
#106=CARTESIAN_POINT('G',(1.,2.,3.));
#107=CARTESIAN_POINT('H',(0.,2.,3.));
#110=VERTEX_POINT('A',#100);
#111=VERTEX_POINT('B',#101);
#112=VERTEX_POINT('C',#102);
#113=VERTEX_POINT('D',#103);
#114=VERTEX_POINT('E',#104);
#115=VERTEX_POINT('F',#105);
#116=VERTEX_POINT('G',#106);
#117=VERTEX_POINT('H',#107);

#200=DIRECTION('+x',(1.,0.,0.));
#201=DIRECTION('+y',(0.,1.,0.));
#202=DIRECTION('+z',(0.,0.,1.));
#203=DIRECTION('-x',(-1.,0.,0.));
#204=DIRECTION('-y',(0.,-1.,0.));
#205=DIRECTION('-z',(0.,0.,-1.));
#206=VECTOR('',#200,1.);
#207=VECTOR('',#201,1.);
#208=VECTOR('',#202,1.);
#209=VECTOR('',#203,1.);
#216=VECTOR('',#204,1.);

#120=LINE('AB',#100,#206);
#121=LINE('BC',#101,#207);
#122=LINE('CD',#102,#209);
#123=LINE('DA',#103,#216);
#124=LINE('EF',#104,#206);
