#214=FACE_OUTER_BOUND('',#164,.T.);
#215=FACE_OUTER_BOUND('',#165,.T.);

/* Every plane axis points out of the solid; all faces use same_sense=T. */
#220=AXIS2_PLACEMENT_3D('bottom',#100,#205,#200);
#221=AXIS2_PLACEMENT_3D('top',#104,#202,#200);
#222=AXIS2_PLACEMENT_3D('front',#100,#204,#200);
#223=AXIS2_PLACEMENT_3D('right',#101,#200,#201);
