ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Self-authored analytic circular cylinder: radius 1 m, height 2 m'),'2;1');
FILE_NAME('analytic-cylinder-m.step','2026-10-15T00:00:00',('FEM Lab'),('FEM Lab'),'Hand-authored STEP fixture','Independent analytic geometry','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
/* Exact circular cylinder x*x+y*y<=1, 0<=z<=2, in metres. */
#1=APPLICATION_CONTEXT('configuration controlled 3d designs of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','config_control_design',1994,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('analytic-cylinder','analytic-cylinder','radius 1 m, height 2 m',(#3));
#5=PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('1','',#4,.NOT_KNOWN.);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#10);
#10=ADVANCED_BREP_SHAPE_REPRESENTATION('analytic-cylinder',(#11,#220),#904);
#11=MANIFOLD_SOLID_BREP('analytic-cylinder',#12);
#12=CLOSED_SHELL('',(#240,#241,#242));

#100=CARTESIAN_POINT('lower-centre',(0.,0.,0.));
#101=CARTESIAN_POINT('upper-centre',(0.,0.,2.));
#102=CARTESIAN_POINT('lower-seam',(1.,0.,0.));
#103=CARTESIAN_POINT('upper-seam',(1.,0.,2.));
#110=VERTEX_POINT('lower-seam',#102);
#111=VERTEX_POINT('upper-seam',#103);
#200=DIRECTION('+x',(1.,0.,0.));
#202=DIRECTION('+z',(0.,0.,1.));
#205=DIRECTION('-z',(0.,0.,-1.));
#207=VECTOR('',#202,1.);
#220=AXIS2_PLACEMENT_3D('model',#100,#202,#200);
#221=AXIS2_PLACEMENT_3D('upper',#101,#202,#200);
#222=AXIS2_PLACEMENT_3D('lower-outward',#100,#205,#200);

/* Shared circular edges run counterclockwise about +z. */
#120=CIRCLE('lower-circle',#220,1.);
#121=CIRCLE('upper-circle',#221,1.);
#122=LINE('seam-line',#102,#207);
#230=CYLINDRICAL_SURFACE('lateral',#220,1.);
#231=PLANE('lower',#222);
#232=PLANE('upper',#221);

/* Two exact parameter-space copies of the same periodic seam. */
#300=CARTESIAN_POINT('u-zero',(0.,0.));
#301=CARTESIAN_POINT('u-two-pi',(6.283185307179586,0.));
#302=DIRECTION('+v',(0.,1.));
#303=VECTOR('',#302,1.);
#304=LINE('u-zero',#300,#303);
#305=LINE('u-two-pi',#301,#303);
#306=DEFINITIONAL_REPRESENTATION('',(#304),#310);
#307=DEFINITIONAL_REPRESENTATION('',(#305),#310);
#308=PCURVE('',#230,#306);
#309=PCURVE('',#230,#307);
#310=(GEOMETRIC_REPRESENTATION_CONTEXT(2) PARAMETRIC_REPRESENTATION_CONTEXT() REPRESENTATION_CONTEXT('','2D'));
#123=SEAM_CURVE('seam',#122,(#308,#309),.CURVE_3D.);

#140=EDGE_CURVE('lower-circle',#110,#110,#120,.T.);
#141=EDGE_CURVE('upper-circle',#111,#111,#121,.T.);
#142=EDGE_CURVE('seam',#110,#111,#123,.T.);
#170=ORIENTED_EDGE('',*,*,#140,.T.);
#171=ORIENTED_EDGE('',*,*,#142,.T.);
#172=ORIENTED_EDGE('',*,*,#141,.F.);
#173=ORIENTED_EDGE('',*,*,#142,.F.);
#174=ORIENTED_EDGE('',*,*,#140,.F.);
#175=ORIENTED_EDGE('',*,*,#141,.T.);
#160=EDGE_LOOP('lateral',(#170,#171,#172,#173));
#161=EDGE_LOOP('lower',(#174));
#162=EDGE_LOOP('upper',(#175));
#210=FACE_OUTER_BOUND('',#160,.T.);
#211=FACE_OUTER_BOUND('',#161,.T.);
#212=FACE_OUTER_BOUND('',#162,.T.);
#240=ADVANCED_FACE('lateral',(#210),#230,.T.);
#241=ADVANCED_FACE('lower',(#211),#231,.T.);
#242=ADVANCED_FACE('upper',(#212),#232,.T.);

#900=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#901=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#902=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#903=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-9),#900,'distance_accuracy_value','');
#904=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#903)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#900,#901,#902)) REPRESENTATION_CONTEXT('','3D'));
ENDSEC;
END-ISO-10303-21;
