+// FEM Lab #351, 2026-10-15: inspect every container, stopping at supported faces.
+// An edge/vertex inside a face is supported topology; a free one would be omitted.
+static void InspectShape (const TopoDS_Shape& shape, bool triangulated, ConversionReport& report)
+{
+    if (shape.IsNull ()) {
+        throw ConversionError ("STEP_EMPTY_TOPOLOGY", "A source shape is null", "topology");
+    }
+    if (shape.ShapeType () == TopAbs_FACE) {
+        if (!triangulated) {
+            report.faces++;
+            if (report.faces > 500000) {
+                throw ConversionError ("STEP_TRIANGLE_LIMIT", "More source faces than the 500000-triangle limit permits", "topology");
+            }
+            return;
+        }
+        TopLoc_Location location;
+        Handle (Poly_Triangulation) mesh = BRep_Tool::Triangulation (TopoDS::Face (shape), location);
+        if (mesh.IsNull () || mesh->NbNodes () == 0 || mesh->NbTriangles () == 0) {
+            throw ConversionError ("STEP_FACE_MISSING_TRIANGULATION", "A source face has no nonempty triangulation", "tessellation");
+        }
+        if (mesh->NbTriangles () > 500000 - report.triangles) {
+            throw ConversionError ("STEP_TRIANGLE_LIMIT", "Converted geometry exceeds the 500000-triangle limit", "tessellation");
+        }
+        report.triangles += mesh->NbTriangles ();
+        return;
+    }
+    if (shape.ShapeType () != TopAbs_COMPOUND && shape.ShapeType () != TopAbs_COMPSOLID &&
+        shape.ShapeType () != TopAbs_SOLID && shape.ShapeType () != TopAbs_SHELL) {
+        throw ConversionError ("STEP_UNSUPPORTED_TOPOLOGY", "Free wires, edges and vertices cannot be represented as triangle geometry", "topology");
+    }
+    TopoDS_Iterator child (shape);
+    if (!child.More ()) {
+        throw ConversionError ("STEP_EMPTY_TOPOLOGY", "A source container has no geometry", "topology");
+    }
+    for (; child.More (); child.Next ()) {
+        InspectShape (child.Value (), triangulated, report);
+    }
+}
 
