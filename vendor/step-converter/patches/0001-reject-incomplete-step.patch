+// FEM Lab #351, 2026-10-15: additive, versioned completeness receipt.
+static emscripten::val MakeReceipt (const ConversionReport& report, bool complete, int meshes = 0)
+{
+    emscripten::val receipt (emscripten::val::object ());
+    receipt.set ("version", std::string ("occt-import-js-0.0.23+femlab.1"));
+    receipt.set ("complete", complete);
+    receipt.set ("roots", report.roots);
+    receipt.set ("transferredRoots", report.transferredRoots);
+    receipt.set ("sourceRoots", report.sourceRoots);
+    receipt.set ("faces", report.faces);
+    receipt.set ("meshes", meshes);
+    receipt.set ("triangles", report.triangles);
+    return receipt;
+}
+
+static emscripten::val Failed (const ConversionReport& report, const std::string& code, const std::string& cause, const std::string& where)
+{
+    emscripten::val result (emscripten::val::object ());
+    result.set ("success", false);
+    result.set ("femlab", MakeReceipt (report, false));
+    emscripten::val error (emscripten::val::object ());
+    error.set ("code", code);
+    error.set ("cause", cause);
+    error.set ("where", where);
+    result.set ("error", error);
+    return result;
+}
 
