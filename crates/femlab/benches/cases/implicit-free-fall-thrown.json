{
  "name": "implicit-free-fall-thrown",
  "reference": "Benchmark F2c, implicit: the same thrown block by HHT-alpha at alpha = -0.05 in ten steps. The alpha-method is exact for a constant acceleration whatever its beta and gamma, and a rigid motion is in the null space of K, so u = v0 t + g t^2/2 = (0.3, -0.2, 0.095095) mm to round-off; the initial acceleration is solved from the consistent gravity load, M a0 = f, which gives g at every node.",
  "journal": [
    {
      "cmd": "model.new",
      "name": "implicit-free-fall-thrown"
    },
    {
      "cmd": "model.setUnits",
      "units": {
        "length": "mm",
        "time": "s"
      }
    },
    {
      "cmd": "geometry.addBox",
      "name": "block",
      "size": [
        "100 mm",
        "100 mm",
        "100 mm"
      ]
    },
    {
      "cmd": "geometry.nameRegion",
      "name": "whole",
      "where": {
        "kind": "body",
        "name": "block"
      }
    },
    {
      "cmd": "material.add",
      "name": "steel",
      "E": "210 GPa",
      "nu": 0.3,
      "rho": "7800 kg/m^3"
    },
    {
      "cmd": "material.assign",
      "material": "steel",
      "bodies": [
        "block"
      ]
    },
    {
      "cmd": "mesh.set",
      "mesher": {
        "kind": "lattice",
        "size": {
          "nx": 2,
          "ny": 2,
          "nz": 2
        }
      }
    },
    {
      "cmd": "load.gravity",
      "name": "g",
      "g": [
        "0 m/s^2",
        "0 m/s^2",
        "-9.81 m/s^2"
      ]
    },
    {
      "cmd": "step.add",
      "name": "throw",
      "procedure": "implicit",
      "constraints": [],
      "loads": [
        "g"
      ],
      "output": [
        "displacement"
      ],
      "tEnd": "1 ms",
      "initialVelocity": [
        {
          "on": "whole",
          "value": [
            "0.3 m/s",
            "-0.2 m/s",
            "0.1 m/s"
          ]
        }
      ],
      "dt": "0.1 ms",
      "alpha": -0.05,
      "outputEvery": 2
    },
    {
      "cmd": "solve.run",
      "step": "throw"
    }
  ],
  "checks": [
    {
      "query": {
        "query": "query.probe",
        "field": "displacement",
        "at": [
          "50 mm",
          "50 mm",
          "50 mm"
        ],
        "component": 0
      },
      "path": "/value/value",
      "expect": 0.3,
      "tol": 1e-06,
      "rel": true,
      "note": "v0x t after 1 ms, in mm"
    },
    {
      "query": {
        "query": "query.probe",
        "field": "displacement",
        "at": [
          "50 mm",
          "50 mm",
          "50 mm"
        ],
        "component": 1
      },
      "path": "/value/value",
      "expect": -0.2,
      "tol": 1e-06,
      "rel": true,
      "note": "v0y t"
    },
    {
      "query": {
        "query": "query.probe",
        "field": "displacement",
        "at": [
          "50 mm",
          "50 mm",
          "50 mm"
        ],
        "component": 2
      },
      "path": "/value/value",
      "expect": 0.095095,
      "tol": 1e-06,
      "rel": true,
      "note": "v0z t + g t^2/2 = 0.1 mm - 4.905 um"
    },
    {
      "query": {
        "query": "query.probe",
        "field": "displacement",
        "at": [
          "0 mm",
          "0 mm",
          "0 mm"
        ],
        "component": 2
      },
      "path": "/value/value",
      "expect": 0.095095,
      "tol": 1e-06,
      "rel": true,
      "note": "every node moves together: no strain"
    }
  ]
}
