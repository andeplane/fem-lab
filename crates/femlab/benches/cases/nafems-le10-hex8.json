{
  "name": "le10-full-face-hex8",
  "reference": "Benchmark D1: ESRD full-face-support variant of NAFEMS LE10, not the original mid-plane-line support. Elliptic plate, E=210 GPa, nu=0.3, thickness 0.6 m, 1 MPa top pressure, quarter symmetry, all displacement components fixed on the whole outer elliptic face. ESRD StressCheck Benchmarks Guide (2018), pp. 29\u201331, reports -5.25 MPa for this full-face variant; the original NAFEMS line-supported problem has the different -5.38 MPa reference. Source: https://www.esrd.com/wp-content/uploads/dlm_uploads/Benchmarks-Guide-Standard-NAFEMS-Benchmarks-Linear-Elastic-Tests.pdf. 12 x 12 x 4 hex8 with Wilson\u2013Taylor incompatible modes gives -5.400396 MPa. This is a recorded element-order result, not an independently validated stress oracle.",
  "journal": [
    {
      "cmd": "model.new",
      "name": "nafems-le10"
    },
    {
      "cmd": "model.setUnits",
      "units": {
        "length": "m",
        "stress": "MPa",
        "force": "N"
      }
    },
    {
      "cmd": "material.add",
      "name": "steel",
      "E": "210 GPa",
      "nu": 0.3
    },
    {
      "cmd": "mesh.set",
      "mesher": {
        "kind": "sweep",
        "base": {
          "kind": "mapped",
          "body": "plate",
          "blocks": [
            {
              "corners": [
                [
                  "2 m",
                  "0 m"
                ],
                [
                  "3.25 m",
                  "0 m"
                ],
                [
                  "0 m",
                  "2.75 m"
                ],
                [
                  "0 m",
                  "1 m"
                ]
              ],
              "edges": [
                {
                  "kind": "line"
                },
                {
                  "kind": "ellipse",
                  "center": [
                    "0 m",
                    "0 m"
                  ],
                  "semiAxes": [
                    "3.25 m",
                    "2.75 m"
                  ]
                },
                {
                  "kind": "line"
                },
                {
                  "kind": "ellipse",
                  "center": [
                    "0 m",
                    "0 m"
                  ],
                  "semiAxes": [
                    "2 m",
                    "1 m"
                  ]
                }
              ],
              "n": [
                12,
                12
              ],
              "tags": [
                "y0",
                "outer",
                "x0",
                "inner"
              ]
            }
          ]
        },
        "sweep": {
          "kind": "extrude",
          "layers": 4,
          "height": "0.6 m"
        }
      },
      "order": 1
    },
    {
      "cmd": "material.assign",
      "material": "steel",
      "bodies": [
        "plate"
      ]
    },
    {
      "cmd": "constraint.symmetry",
      "name": "symx",
      "on": "plate.x0",
      "normal": "x"
    },
    {
      "cmd": "constraint.symmetry",
      "name": "symy",
      "on": "plate.y0",
      "normal": "y"
    },
    {
      "cmd": "constraint.fix",
      "name": "rim",
      "on": "plate.outer"
    },
    {
      "cmd": "load.pressure",
      "name": "top",
      "on": "plate.top",
      "value": "1 MPa"
    },
    {
      "cmd": "step.add",
      "name": "static",
      "procedure": "static",
      "constraints": [
        "symx",
        "symy",
        "rim"
      ],
      "loads": [
        "top"
      ]
    },
    {
      "cmd": "solve.run",
      "step": "static"
    }
  ],
  "checks": [
    {
      "query": {
        "query": "query.probe",
        "field": "stress",
        "component": 1,
        "at": [
          "2 m",
          "0 m",
          "0.6 m"
        ]
      },
      "path": "/value/value",
      "expect": -5.400396388475902,
      "tol": 0.02,
      "rel": true,
      "note": "Recorded hex8 result; independent full-face reference is -5.25 MPa, original line-supported LE10 reference is -5.38 MPa"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/balance",
      "expect": 0,
      "tol": 1e-08,
      "note": "A7: reactions balance the applied load"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/stale",
      "expect": false
    }
  ]
}
