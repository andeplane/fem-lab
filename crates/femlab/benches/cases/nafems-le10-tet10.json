{
  "name": "nafems-le10-tet10",
  "reference": "Benchmark D1, ESRD full-outer-face variant of NAFEMS LE10: sigma_yy(D) = -5.25 MPa, 2% tolerance. The original mid-plane-line support reference -5.38 MPa is a different problem. Quadratic tetrahedra split from a swept mapped elliptic block; registry convergence checks 6x6x4, 12x12x8 and 18x18x8 parent cells. Source: ESRD Standard NAFEMS Benchmarks, LE10.",
  "journal": [
    {
      "cmd": "model.new",
      "name": "nafems-le10"
    },
    {
      "cmd": "model.setUnits",
      "units": {
        "length": "m",
        "stress": "MPa",
        "force": "N"
      }
    },
    {
      "cmd": "material.add",
      "name": "steel",
      "E": "210 GPa",
      "nu": 0.3
    },
    {
      "cmd": "mesh.set",
      "mesher": {
        "kind": "sweep",
        "base": {
          "kind": "mapped",
          "body": "plate",
          "blocks": [
            {
              "corners": [
                [
                  "2 m",
                  "0 m"
                ],
                [
                  "3.25 m",
                  "0 m"
                ],
                [
                  "0 m",
                  "2.75 m"
                ],
                [
                  "0 m",
                  "1 m"
                ]
              ],
              "edges": [
                {
                  "kind": "line"
                },
                {
                  "kind": "ellipse",
                  "center": [
                    "0 m",
                    "0 m"
                  ],
                  "semiAxes": [
                    "3.25 m",
                    "2.75 m"
                  ]
                },
                {
                  "kind": "line"
                },
                {
                  "kind": "ellipse",
                  "center": [
                    "0 m",
                    "0 m"
                  ],
                  "semiAxes": [
                    "2 m",
                    "1 m"
                  ]
                }
              ],
              "n": [
                18,
                18
              ],
              "tags": [
                "y0",
                "outer",
                "x0",
                "inner"
              ]
            }
          ]
        },
        "sweep": {
          "kind": "extrude",
          "layers": 8,
          "height": "0.6 m"
        }
      },
      "order": 2,
      "simplices": true
    },
    {
      "cmd": "material.assign",
      "material": "steel",
      "bodies": [
        "plate"
      ]
    },
    {
      "cmd": "constraint.symmetry",
      "name": "symx",
      "on": "plate.x0",
      "normal": "x"
    },
    {
      "cmd": "constraint.symmetry",
      "name": "symy",
      "on": "plate.y0",
      "normal": "y"
    },
    {
      "cmd": "constraint.fix",
      "name": "rim",
      "on": "plate.outer"
    },
    {
      "cmd": "load.pressure",
      "name": "top",
      "on": "plate.top",
      "value": "1 MPa"
    },
    {
      "cmd": "step.add",
      "name": "static",
      "procedure": "static",
      "constraints": [
        "symx",
        "symy",
        "rim"
      ],
      "loads": [
        "top"
      ]
    },
    {
      "cmd": "solve.run",
      "step": "static"
    }
  ],
  "checks": [
    {
      "query": {
        "query": "query.probe",
        "field": "stress",
        "component": 1,
        "at": [
          "2 m",
          "0 m",
          "0.6 m"
        ]
      },
      "path": "/value/value",
      "expect": -5.25,
      "tol": 0.02,
      "rel": true,
      "note": "ESRD full-outer-face variant sigma_yy(D) = -5.25 MPa within 2 %"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/balance",
      "expect": 0,
      "tol": 1e-08,
      "note": "A7: reactions balance the applied load"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/stale",
      "expect": false
    }
  ]
}
