{
  "name": "lame-3d-revolve-tet4",
  "reference": "Benchmark D7. The same CSG revolve as lame-3d-revolve-tet10, order 1: constant-strain tet4 instead of tet10, probed at the same r = 0.15 m mid-wall point. The element-order lesson C3 already made for quad4, here for the free tet mesher -- recorded, not gated: `expect` below is the value this case itself measures, so the check regresses on a change rather than judging the element against the closed form (sigma_theta = 55.5556 MPa, sigma_rr = -15.5556 MPa, u_r = 4.246667e-5 m at r = 0.15 m).",
  "journal": [
    {
      "cmd": "model.new",
      "name": "lame-3d-tet4"
    },
    {
      "cmd": "model.setUnits",
      "units": {
        "length": "m",
        "stress": "MPa",
        "force": "N"
      }
    },
    {
      "cmd": "material.add",
      "name": "steel",
      "E": "200 GPa",
      "nu": 0.3
    },
    {
      "cmd": "geometry.add",
      "name": "tube",
      "shape": {
        "kind": "revolve",
        "angle": 90,
        "segments": 16,
        "sketch": {
          "outer": [
            {
              "kind": "line",
              "to": [
                "0.2 m",
                "0 m"
              ],
              "tag": "zmin"
            },
            {
              "kind": "line",
              "to": [
                "0.2 m",
                "0.1 m"
              ],
              "tag": "outer"
            },
            {
              "kind": "line",
              "to": [
                "0.1 m",
                "0.1 m"
              ],
              "tag": "zmax"
            },
            {
              "kind": "line",
              "to": [
                "0.1 m",
                "0 m"
              ],
              "tag": "inner"
            }
          ]
        }
      }
    },
    {
      "cmd": "mesh.set",
      "mesher": {
        "kind": "tet",
        "size": "0.02 m"
      },
      "order": 1
    },
    {
      "cmd": "material.assign",
      "material": "steel",
      "bodies": [
        "tube"
      ]
    },
    {
      "cmd": "constraint.symmetry",
      "name": "theta0",
      "on": "tube.theta0",
      "normal": "y"
    },
    {
      "cmd": "constraint.symmetry",
      "name": "theta1",
      "on": "tube.theta1",
      "normal": "x"
    },
    {
      "cmd": "constraint.fix",
      "name": "zmin",
      "on": "tube.zmin",
      "dofs": [
        "uz"
      ]
    },
    {
      "cmd": "constraint.fix",
      "name": "zmax",
      "on": "tube.zmax",
      "dofs": [
        "uz"
      ]
    },
    {
      "cmd": "load.pressure",
      "name": "inside",
      "on": "tube.inner",
      "value": "60 MPa"
    },
    {
      "cmd": "step.add",
      "name": "static",
      "procedure": "static",
      "constraints": [
        "theta0",
        "theta1",
        "zmin",
        "zmax"
      ],
      "loads": [
        "inside"
      ]
    },
    {
      "cmd": "solve.run",
      "step": "static"
    }
  ],
  "checks": [
    {
      "query": {
        "query": "query.probe",
        "field": "stress",
        "component": 1,
        "at": [
          "0.15 m",
          "0 m",
          "0.05 m"
        ]
      },
      "path": "/value/value",
      "expect": 35.03376562094382,
      "tol": 0.02,
      "rel": true,
      "note": "sigma_theta(0.15 m) recorded: the exact value is 55.5556 MPa"
    },
    {
      "query": {
        "query": "query.probe",
        "field": "stress",
        "component": 0,
        "at": [
          "0.15 m",
          "0 m",
          "0.05 m"
        ]
      },
      "path": "/value/value",
      "expect": -21.98938417778431,
      "tol": 0.02,
      "rel": true,
      "note": "sigma_rr(0.15 m) recorded: the exact value is -15.5556 MPa"
    },
    {
      "query": {
        "query": "query.probe",
        "field": "displacement",
        "component": 0,
        "at": [
          "0.15 m",
          "0 m",
          "0.05 m"
        ]
      },
      "path": "/value/value",
      "expect": 3.6581303617471e-05,
      "tol": 0.02,
      "rel": true,
      "note": "u_r(0.15 m) recorded: the exact value is 4.246667e-5 m"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/balance",
      "expect": 0,
      "tol": 1e-08,
      "note": "A7: reactions balance the applied load"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/stale",
      "expect": false
    }
  ]
}
