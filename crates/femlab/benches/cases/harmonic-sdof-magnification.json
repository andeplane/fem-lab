{
  "name": "harmonic-sdof-magnification",
  "reference": "Benchmark F5: the damped magnification curve of a single degree of freedom, |u|/u_static = 1/sqrt((1-r^2)^2 + (2 zeta r)^2) with phase = atan2(2 zeta r, 1-r^2), at r = f/f_n from 0.1 to 3.0 and zeta = 0.02, 0.05 and 0.2. One hex8 is clamped at xmin and guided at xmax, so the only free displacements are the four axial ones on the loaded face; that face's symmetry makes their uniform combination its own mode and a uniform axial traction excites nothing else, so the model IS one degree of freedom and mode superposition is exact rather than approximate. Gated at 1e-8: a loose tolerance here would hide a real error in the complex denominator, the phase convention or the modal participation. u_static comes from the static procedure and f_n from the modal one, and both are pinned by their own checks in this case.",
  "journal": [
    {
      "cmd": "model.new",
      "name": "harmonic-sdof-magnification"
    },
    {
      "cmd": "geometry.addBox",
      "name": "bar",
      "size": [
        "1 m",
        "0.1 m",
        "0.1 m"
      ]
    },
    {
      "cmd": "material.add",
      "name": "steel",
      "E": "210 GPa",
      "nu": 0.3,
      "rho": "7800 kg/m^3",
      "source": "EN 10025"
    },
    {
      "cmd": "material.assign",
      "material": "steel",
      "bodies": [
        "bar"
      ]
    },
    {
      "cmd": "mesh.set",
      "mesher": {
        "kind": "lattice",
        "size": {
          "nx": 1,
          "ny": 1,
          "nz": 1
        }
      },
      "order": 1,
      "formulation": "full"
    },
    {
      "cmd": "constraint.fix",
      "name": "root",
      "on": "bar.xmin"
    },
    {
      "cmd": "constraint.fix",
      "name": "guide",
      "on": "bar.xmax",
      "dofs": [
        "uy",
        "uz"
      ]
    },
    {
      "cmd": "load.traction",
      "name": "pull",
      "on": "bar.xmax",
      "total": [
        "10 kN",
        "0 N",
        "0 N"
      ]
    },
    {
      "cmd": "step.add",
      "name": "pull-static",
      "procedure": "static",
      "constraints": [
        "root",
        "guide"
      ],
      "loads": [
        "pull"
      ],
      "output": [
        "displacement"
      ]
    },
    {
      "cmd": "step.add",
      "name": "modes",
      "procedure": "modal",
      "constraints": [
        "root",
        "guide"
      ],
      "loads": [],
      "output": [
        "displacement"
      ],
      "nModes": 4
    },
    {
      "cmd": "step.add",
      "name": "sweep-002",
      "procedure": "harmonic",
      "constraints": [
        "root",
        "guide"
      ],
      "loads": [
        "pull"
      ],
      "output": [
        "displacement"
      ],
      "after": "modes",
      "fStart": "165.95504263194275 Hz",
      "fStop": "4978.6512789582821 Hz",
      "points": 30,
      "sweep": "linear",
      "dampingRatio": 0.02
    },
    {
