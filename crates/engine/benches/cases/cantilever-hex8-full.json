{
  "name": "cantilever-hex8-full",
  "reference": "Benchmark B1, the locking lesson. The same cantilever as cantilever-hex8-im with formulation: full, the textbook fully integrated linear hexahedron. At the same 25 mm lattice it gives 0.1837801 mm, 4.26 % below the Timoshenko value against the incompatible element's 0.96 %; coarsen to 50 mm and the errors are 13.1 % against 1.34 %, and to 100 mm 24 % against 1.45 %. The tolerance here is deliberately wide: the number is recorded, not gated, because what matters is the ratio, which a Rust test in tests/registry.rs asserts.",
  "journal": [
    {
      "cmd": "model.new",
      "name": "cantilever"
    },
    {
      "cmd": "model.setUnits",
      "units": {
        "length": "mm",
        "stress": "MPa",
        "force": "kN"
      }
    },
    {
      "cmd": "geometry.addBox",
      "name": "beam",
      "size": [
        "1 m",
        "100 mm",
        "100 mm"
      ]
    },
    {
      "cmd": "material.add",
      "name": "steel",
      "E": "210 GPa",
      "nu": 0.3,
      "rho": "7850 kg/m^3",
      "source": "EN 10025"
    },
    {
      "cmd": "material.assign",
      "material": "steel",
      "bodies": [
        "beam"
      ]
    },
    {
      "cmd": "mesh.set",
      "mesher": {
        "kind": "lattice",
        "size": "25 mm"
      },
      "order": 1,
      "formulation": "full"
    },
    {
      "cmd": "constraint.fix",
      "name": "root",
      "on": "beam.xmin"
    },
    {
      "cmd": "load.traction",
      "name": "tip",
      "on": "beam.xmax",
      "total": [
        "0 N",
        "0 N",
        "-1 kN"
      ]
    },
    {
      "cmd": "step.add",
      "name": "static",
      "procedure": "static",
      "constraints": [
        "root"
      ],
      "loads": [
        "tip"
      ]
    },
    {
      "cmd": "solve.run",
      "step": "static"
    }
  ],
  "checks": [
    {
      "query": {
        "query": "query.probe",
        "field": "displacement",
        "component": 2,
        "at": [
          "1 m",
          "50 mm",
          "50 mm"
        ]
      },
      "path": "/value/value",
      "expect": -0.1837801,
      "tol": 0.02,
      "rel": true,
      "note": "tip deflection in mm; recorded, and 4.26 % below Timoshenko because the element locks"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/balance",
      "expect": 0.0,
      "tol": 1e-09,
      "note": "A7: reactions balance the applied load"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/stale",
      "expect": false
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/solver",
      "expect": "cpu-direct"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/appliedTotal/2/value",
      "expect": -1.0,
      "tol": 1e-09,
      "rel": true,
      "note": "the tip traction totals -1 kN"
    },
    {
      "query": {
        "query": "query.result"
      },
      "path": "/reactions/0/total/2/value",
      "expect": 1.0,
      "tol": 1e-09,
      "rel": true,
      "note": "and the root carries it"
    }
  ]
}
