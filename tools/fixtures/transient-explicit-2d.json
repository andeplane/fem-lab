[
  {
    "cmd": "model.new",
    "name": "transient-explicit-2d"
  },
  {
    "cmd": "model.setUnits",
    "units": {
      "temperature": "degC",
      "length": "mm",
      "time": "min"
    }
  },
  {
    "cmd": "model.setIdealisation",
    "idealisation": {
      "kind": "planeStress",
      "thickness": "0.1 m"
    }
  },
  {
    "cmd": "geometry.addBox",
    "name": "bar",
    "size": [
      "1 m",
      "0.1 m",
      "0.1 m"
    ]
  },
  {
    "cmd": "material.add",
    "name": "mat",
    "E": "1 MPa",
    "nu": 0.25,
    "rho": "2 kg/m^3",
    "k": "6 W/(m*K)",
    "cp": "3 J/(kg*K)"
  },
  {
    "cmd": "material.assign",
    "material": "mat",
    "bodies": [
      "bar"
    ]
  },
  {
    "cmd": "mesh.set",
    "mesher": {
      "kind": "mapped",
      "body": "sheet",
      "blocks": [
        {
          "corners": [
            [
              "0 m",
              "0 m"
            ],
            [
              "1 m",
              "0 m"
            ],
            [
              "1 m",
              "0.1 m"
            ],
            [
              "0 m",
              "0.1 m"
            ]
          ],
          "n": [
            2,
            1
          ],
          "tags": [
            "bottom",
            "right",
            "top",
            "left"
          ]
        }
      ]
    },
    "order": 1
  },
  {
    "cmd": "material.assign",
    "material": "mat",
    "bodies": [
      "sheet"
    ]
  },
  {
    "cmd": "load.gravity",
    "name": "gravity",
    "g": [
      "0 m/s^2",
      "-9.81 m/s^2",
      "0 m/s^2"
    ]
  },
  {
    "cmd": "step.add",
    "name": "fall",
    "procedure": "explicit",
    "constraints": [],
    "loads": [
      "gravity"
    ],
    "tEnd": "1.3 ms",
    "dtFactor": 0.5,
    "outputEvery": 3
  },
  {
    "cmd": "solve.run",
    "step": "fall"
  }
]
